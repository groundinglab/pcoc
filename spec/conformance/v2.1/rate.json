      "class": "negative",
      "must_reject": true,
      "hike_legs": 2,
      "hike_span": 11,
      "meets": false
    },
    {
      "name": "boundary-meet",
      "class": "positive",
      "hike_legs": 1,
      "hike_span": 5,
      "meets": true
    },
    {
      "name": "boundary-fail",
      "class": "negative",
      "must_reject": true,
      "hike_legs": 1,
      "hike_span": 6,
      "meets": false
    },
    {
      "name": "span-zero",
      "class": "negative",
      "must_reject": true,
      "hike_legs": 2,
      "hike_span": 0,
      "meets": false,
      "outcome": "refuse"
