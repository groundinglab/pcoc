# Optional environment for pcoc-admission.service. Copy to
# /etc/pcoc-admission/env (mode 0640) and edit. Placeholders only.
#
# The gate reads one variable: the path of its TOML config. Everything else,
# including the bind address (default 127.0.0.1:8787, loopback only), the
# index origin and the CORS origins, lives in that file. See gate.toml.
GATE_CONFIG=/etc/pcoc-admission/gate.toml

# CORS origins for a live groundinglab deploy. The gate does not read CORS
# from the environment: this value must be set as `allowed_origins` in the
# config file named above (deploy/gate.toml already carries it). The code
# default is empty (loopback only), so without it website sign-in is refused.
# allowed_origins = ["https://groundinglab.io", "https://www.groundinglab.io"]

# Build-time only, not read at runtime: `COMMIT=<sha> cargo build --release`
# stamps the commit that GET /v1/health reports.
