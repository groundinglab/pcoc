# Do not deploy this tree over the live v2.0 service. This branch is Satoshi Hike 2.2.
[Unit]
Description=bari: waypoint POST and path GET (Satoshi Hike)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bari
Group=bari
EnvironmentFile=/etc/bari/env
ExecStart=/usr/local/bin/bari
Restart=on-failure
RestartSec=5
StateDirectory=bari
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
