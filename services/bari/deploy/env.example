# Do not deploy this tree over the live v2.0 service. This branch is Satoshi Hike 2.2.
# bari environment. Example only: every value is a placeholder.
# Copy to /etc/bari/env (mode 0600) and edit. ../README.md describes every key.

# HTTP bind. Loopback only; a reverse proxy in front serves the public name.
BARI_BIND_ADDR=127.0.0.1:38080
BARI_DATA_DIR=/var/lib/bari
BARI_INSTANCE=local

# Public origin mixed into bari-hc-v2 (SPEC §13.1). Scheme, host, and a
# non-default port. No path. Startup refuses when this is unset or not http(s).
BARI_PUBLIC_ORIGIN=https://bari.example

# Tip: Bitcoin selected-chain header gossip from one peer you run (network main).
BARI_TIP_SOURCE=bitcoin-gossip
PCOC_LIVE_GOSSIP_PEER=127.0.0.1:8333
BARI_BITCOIN_NETWORK=main

# Plant: Bitcoin Core JSON-RPC on the same host. Cookie file, or user and password.
BARI_BITCOIN_RPC_URL=http://127.0.0.1:38332
BARI_BITCOIN_COOKIE_FILE=/var/lib/bitcoind/.cookie
# BARI_BITCOIN_RPC_USER=<rpc-user>
# BARI_BITCOIN_RPC_PASSWORD=<rpc-password>
BARI_BITCOIN_WALLET=<wallet-name>

# Fee. Highest sat/vB this process broadcasts; default 1.1, other values are refused.
# The bid is min(BARI_FEE_MULTIPLIER x next-block minimum, cap). A tree is broadcast
# only while the next-block minimum is below 1.1.
BARI_FEE_CAP_SAT_VB=1.1
BARI_FEE_MULTIPLIER=1.5
# BARI_FEE_BID_SAT_VB and BARI_DEFER_ABOVE_SAT_VB are retired. If either is set, startup refuses.
