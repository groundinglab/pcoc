# pcoc-index environment. Example only: every value is a placeholder.
# Copy to /etc/pcoc-index/env and edit. ../README.md describes every key.

# The directory of height-XXXXXXXXXX.json files that bari writes ($BARI_DATA_DIR/index).
PCOC_INDEX_DATA_DIR=/var/lib/bari/index
# Loopback only; a reverse proxy in front serves the public name.
PCOC_INDEX_BIND_ADDR=127.0.0.1:38081
# Optional: directory of state.json and events.jsonl that fills header.time.
# PCOC_INDEX_SEQUENCER_DIR=/var/lib/<sequencer>
